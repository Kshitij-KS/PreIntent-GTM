# Preintent — environment template
# Copy to `.env.local` and fill in values. Restart `npm run dev` after changes.
#
# Mode values: mock | real | disabled (where supported)
# Missing keys → automatic mock fallback (demo at /demo always uses mock data)

# ─── Supabase (auth + org persistence) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Bright Data (Void Scanner · Compliance Radar · Pain Listener) ─────────────
BRIGHT_DATA_MODE=mock
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ENDPOINT=
BRIGHT_DATA_ZONE=preintent
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_DEFAULT_PRICING_URL=
BRIGHT_DATA_DEFAULT_REGULATORY_QUERY=

# ─── AI/ML API (signal scoring + Intel Brief generation) ─────────────────────
AI_ML_MODE=mock
AI_ML_API_KEY=
AI_ML_ENDPOINT=
AI_ML_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ─── Featherless AI (pain signal classification) ─────────────────────────────
# Alternatives: set GROQ_* or GEMINI_* instead (see actions.ts)
FEATHERLESS_MODE=mock
FEATHERLESS_API_KEY=
FEATHERLESS_ENDPOINT=
FEATHERLESS_MODEL=

# ─── Speechmatics (podcast / audio transcription) ────────────────────────────
SPEECHMATICS_MODE=mock
SPEECHMATICS_API_KEY=
SPEECHMATICS_ENDPOINT=
SPEECHMATICS_AUDIO_URL=

# ─── Slack (convergence alerts) ──────────────────────────────────────────────
SLACK_MODE=mock
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#gtm-intel
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── HubSpot (CRM lead on threshold) ─────────────────────────────────────────
HUBSPOT_MODE=mock
HUBSPOT_WEBHOOK_URL=
HUBSPOT_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
